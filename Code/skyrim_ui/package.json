{
  "name": "skyrim-together-ui",
  "version": "0.0.0",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --disable-host-check --configuration=browser",
    "build": "ng build",
    "deploy:develop": "ng build --output-hashing none --configuration=develop --base-href ./",
    "deploy:production": "ng build --output-hashing none --configuration=production --base-href ./",
    "e2e": "ng e2e",
    "format": "prettier -w ./src/**/*.{ts,json,css,scss,html}"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.5",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/platform-browser-dynamic": "^22.2.5",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@jsverse/transloco": "^8.4.0",
    "@ngneat/elf": "^2.5.1",
    "@ngneat/elf-entities": "^5.0.2",
    "@ngneat/loadoff": "^2.1.0",
    "@ngneat/reactive-forms": "^5.0.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@ngx-playwright/test": "^0.7.0",
    "@types/events": "^3.0.0",
    "@types/node": "^26.6.6",
    "events": "^3.3.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}
